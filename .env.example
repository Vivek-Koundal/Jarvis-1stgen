# Copy this file to .env_local and uncomment/configure only the integrations
# you plan to use. Never commit the populated .env_local file.

# Required only for Meta API features (--llm, --voice --llm, or the overlay).
# MODEL_API_KEY=replace-with-your-meta-api-key

# Optional. Set to a vision-capable model ID to use screen control.
# MODEL_API_VISION_MODEL=your-vision-model-id

# Required only for the optional Porcupine wake-word feature.
# PICOVOICE_ACCESS_KEY=replace-with-your-picovoice-access-key
